{
  "name": "envcheck",
  "version": "0.3.0",
  "description": "Compare .env files against a schema of record. Catch missing keys, empty values, orphans, and typos — and scaffold a schema with envcheck init.",
  "type": "module",
  "bin": {
    "envcheck": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".envcheckrc.example"
  ],
  "scripts": {
    "build": "tsup",
    "coverage": "c8 report",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "c8 --reporter=lcov --reporter=text --all node --experimental-strip-types --test test/**/*.test.ts",
    "lint": "prettier --check .",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Toiba",
    "url": "https://github.com/toibawani",
    "email": "toibawani14@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toibawani/envcheck.git"
  },
  "bugs": {
    "url": "https://github.com/toibawani/envcheck/issues"
  },
  "homepage": "https://github.com/toibawani/envcheck#readme",
  "license": "MIT",
  "keywords": [
    "env",
    "dotenv",
    "cli",
    "config",
    "schema",
    "secrets",
    "environment-variables",
    "drift-detection"
  ],
  "devDependencies": {
    "@types/node": "^22.15.21",
    "c8": "^12.0.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
